# Order file (internal use only)
claude-shogun-orders.md

# Claude Code settings
.claude/*
!.claude/settings.json
.mcp.json

# Test outputs (generated during testing)
test_output/

# Generated skills (local development)
# Exception: プロジェクト成果物 skill の定義ファイル (SKILL.md / .md) は tracked 化
skills/*
!skills/*/
skills/*/*
!skills/*/SKILL.md
!skills/*/*.md

# Temporary files
*.tmp
*.bak

# Demo/analysis outputs (generated during tasks)
demo_output/

# Runtime data (generated during operation)
output/

# Queue runtime data (military-scoped)
# Exception: kaizen.yaml / kaizen_archive.yaml / skill_candidates.md は組織知として tracked 化
queue/armyA/*
!queue/armyA/kaizen.yaml
!queue/armyA/kaizen_archive.yaml
!queue/armyA/skill_candidates.md
queue/armyB/*
!queue/armyB/kaizen.yaml
!queue/armyB/kaizen_archive.yaml
!queue/armyB/skill_candidates.md
queue/taishogun_to_shogun.yaml

# Memory MCP data (local to each installation)
memory/

# Project context (local to each installation, except README)
context/
!context/README.md

# Dashboards (runtime, per-army)
dashboard_armyA.md
dashboard_armyB.md

# Config runtime data
config/projects.yaml
config/settings.yaml
status/
logs/

# Project details (contains client/confidential info)
projects/

# Internal docs (operation logs, test plans, article drafts)
docs/
archive/

# Generated screenshots and logs (task outputs)
*.png
*.log
.playwright-mcp/
plans/
